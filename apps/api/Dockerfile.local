# Fixture-enabled LOCAL preview artifact. Never use for staging/production.
FROM golang:1.27.3-alpine3.24@sha256:d200d2dd76b03a99b52651fd1325aff7dcd35422c35c01bac56571b0507f3deb AS build
WORKDIR /src
ENV GOTOOLCHAIN=local CGO_ENABLED=0
COPY go.mod ./
COPY cmd/ ./cmd/
COPY internal/ ./internal/
RUN go build -trimpath -tags devfixture -o /out/api ./cmd/api

FROM alpine:3.24.2@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
LABEL org.opencontainers.image.description="LOCAL ONLY: synthetic devfixture; forbidden in staging and production"
RUN addgroup -S -g 10001 preview && adduser -S -D -H -u 10001 -G preview preview
COPY --from=build --chmod=0555 /out/api /usr/local/bin/api
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/api"]
